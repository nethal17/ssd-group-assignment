# ============================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================
# These variables are used by the React frontend application
# All frontend variables must be prefixed with VITE_ to be accessible

# API Configuration
# The base URL for backend API calls
VITE_API_URL=http://localhost:3000

VITE_FRONTEND_URL=http://localhost:5173

# Stripe Configuration (Frontend)
# Your Stripe publishable key for payment processing
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_publishable_key_here

# Google Maps Configuration
# Your Google Maps API key for map components
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ============================================
# NOTE: Backend environment variables should be
# configured in /backend/.env.example
# ============================================
